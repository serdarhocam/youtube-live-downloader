{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube Live Downloader",
  "version": "1.9.0",
  "identifier": "com.ytld.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube Live Downloader",
        "width": 1280,
        "height": 860,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "binaries/yt-dlp.exe": "binaries/yt-dlp.exe",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe",
      "binaries/ffprobe.exe": "binaries/ffprobe.exe",
      "binaries/VERSIONS.txt": "binaries/VERSIONS.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
